@model IEnumerable<Hospital.Models.Doctor>

@{
    ViewData["Title"] = "Doctor Management";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-user-md text-primary"></i> Our Medical Team</h2>
        <p class="text-muted">Expert doctors and medical professionals</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-user-md"></i> Add New Doctor
    </a>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-primary text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-user-md fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Count()</h2>
                <p class="mb-0 fs-5">Total Doctors</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-success text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-stethoscope fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Select(d => d.specialization).Distinct().Count()</h2>
                <p class="mb-0 fs-5">Specializations</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-info text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-check-circle fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Count(d => d.status == "Active")</h2>
                <p class="mb-0 fs-5">Active Doctors</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-warning text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-clock fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Count(d => d.status == "On Leave")</h2>
                <p class="mb-0 fs-5">On Leave</p>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-search me-2"></i>Find a Doctor</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Search by name, specialization, or email...">
                </div>
            </div>
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-medkit text-muted"></i>
                    </span>
                    <select id="specializationFilter" class="form-control">
                        <option value="">All Specializations</option>
                        @foreach (var spec in Model.Select(d => d.specialization).Distinct().OrderBy(s => s))
                        {
                            <option value="@spec">@spec</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <select id="statusFilter" class="form-control">
                    <option value="">All Status</option>
                    <option value="Active">Active</option>
                    <option value="On Leave">On Leave</option>
                    <option value="Retired">Retired</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Doctors Grid View -->
<div class="row" id="doctorsGrid">
    @foreach (var doctor in Model)
    {
        <div class="col-xl-3 col-lg-4 col-md-6 mb-4 doctor-card"
             data-name="@doctor.first_name @doctor.last_name"
             data-specialization="@doctor.specialization"
             data-status="@doctor.status">
            <div class="card border-0 shadow-sm h-100 doctor-hover">
                <div class="card-body p-0">
                    <!-- Doctor Header -->
                    <div class="doctor-header p-4 text-center" style="
                            background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);
                            border-radius: 10px 10px 0 0;
                        ">
                        <div class="avatar-circle mx-auto mb-3" style="
                                width: 80px;
                                height: 80px;
                                background: rgba(255,255,255,0.2);
                                border: 3px solid white;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                color: white;
                                font-size: 2rem;
                                font-weight: bold;
                            ">
                            @doctor.first_name?[0]@doctor.last_name?[0]
                        </div>
                        <h5 class="text-white mb-1">Dr. @doctor.first_name @doctor.last_name</h5>
                        <p class="text-white-50 mb-0">@doctor.specialization</p>
                    </div>

                    <!-- Doctor Info -->
                    <div class="p-4">
                        <div class="row g-2 mb-3">
                            <div class="col-12">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-envelope text-muted me-2"></i>
                                    <small class="text-truncate">@doctor.email</small>
                                </div>
                                <div class="d-flex align-items-center mb-2">
                                    <i class="fas fa-phone text-muted me-2"></i>
                                    <small>@doctor.contact_number</small>
                                </div>
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-building text-muted me-2"></i>
                                    <small>Department: @(doctor.Department?.name ?? "Not Assigned")</small>
                                </div>
                            </div>
                        </div>

                        <!-- Status Badge -->
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="badge @(doctor.status == "Active" ? "bg-success" :
                                                                                 doctor.status == "On Leave" ? "bg-warning" :
                                                                                 "bg-secondary") px-3 py-2">
                                <i class="fas fa-circle me-1" style="font-size: 0.6rem;"></i>
                                @doctor.status
                            </span>

                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@doctor.doctor_id"
                                   class="btn btn-sm btn-outline-info" title="View Profile">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Dashboard" asp-route-id="@doctor.doctor_id"
                                   class="btn btn-sm btn-outline-primary" title="Dashboard">
                                    <i class="fas fa-chart-line"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- No Results Message -->
<div id="noResults" class="text-center py-5" style="display: none;">
    <i class="fas fa-search fa-4x text-muted mb-3"></i>
    <h4>No doctors found</h4>
    <p class="text-muted">Try changing your search criteria</p>
</div>

<!-- JavaScript for Filtering -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const specFilter = document.getElementById('specializationFilter');
            const statusFilter = document.getElementById('statusFilter');
            const doctorCards = document.querySelectorAll('.doctor-card');
            const noResults = document.getElementById('noResults');

            function filterDoctors() {
                const searchText = searchInput.value.toLowerCase();
                const selectedSpec = specFilter.value;
                const selectedStatus = statusFilter.value;

                let visibleCount = 0;

                doctorCards.forEach(card => {
                    const name = card.dataset.name.toLowerCase();
                    const specialization = card.dataset.specialization;
                    const status = card.dataset.status;

                    const matchesSearch = name.includes(searchText) ||
                                         specialization.toLowerCase().includes(searchText);
                    const matchesSpec = !selectedSpec || specialization === selectedSpec;
                    const matchesStatus = !selectedStatus || status === selectedStatus;

                    if (matchesSearch && matchesSpec && matchesStatus) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Show/hide no results message
                if (visibleCount === 0) {
                    noResults.style.display = 'block';
                } else {
                    noResults.style.display = 'none';
                }
            }

            // Add event listeners
            searchInput.addEventListener('input', filterDoctors);
            specFilter.addEventListener('change', filterDoctors);
            statusFilter.addEventListener('change', filterDoctors);

            // Initial filter
            filterDoctors();
        });
    </script>
}

<!-- Custom Styles -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%) !important;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%) !important;
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #0dcaf0 0%, #20c997 100%) !important;
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #fd7e14 0%, #ffc107 100%) !important;
    }

    .doctor-hover {
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }

        .doctor-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            border-color: #0d6efd;
        }

    .doctor-header {
        position: relative;
        overflow: hidden;
    }

        .doctor-header::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="rgba(255,255,255,0.1)" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,112C672,96,768,96,864,112C960,128,1056,160,1152,160C1248,160,1344,128,1392,112L1440,96L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>');
            background-size: cover;
            opacity: 0.3;
        }

    .avatar-circle {
        transition: transform 0.3s ease;
    }

    .doctor-hover:hover .avatar-circle {
        transform: scale(1.1);
    }

    .btn-group .btn {
        border-radius: 6px !important;
        margin: 0 2px;
    }
</style>