@model Hospital.Models.Doctor

@{
    ViewData["Title"] = "Doctor Dashboard";
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var pastAppointments = ViewBag.PastAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var todayAppointments = ViewBag.TodayAppointmentsList as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-1"><i class="fas fa-user-md me-2"></i>Doctor Dashboard</h3>
                            <p class="card-text mb-0 opacity-75">Dr. @Model.first_name @Model.last_name - @Model.specialization</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-success fs-6 px-3 py-2">@Model.Department?.name</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Section -->
    @if (pastAppointments.Any() || upcomingAppointments.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Alerts & Notifications</h5>
                    </div>
                    <div class="card-body">
                        @if (pastAppointments.Any())
                        {
                            <div class="alert alert-danger mb-3">
                                <strong><i class="fas fa-calendar-times me-2"></i>Past Appointments:</strong>
                                You have <strong>@pastAppointments.Count</strong> appointment(s) in the past that need attention.
                                <a href="@Url.Action("Index", "Appointments")" class="alert-link ms-2">Review Now →</a>
                            </div>
                        }
                        @if (upcomingAppointments.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <strong><i class="fas fa-calendar-check me-2"></i>Upcoming Appointments:</strong>
                                You have <strong>@upcomingAppointments.Count</strong> appointment(s) scheduled soon.
                                <a href="@Url.Action("Calendar", "Appointments")" class="alert-link ms-2">View Calendar →</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5>Today's Appointments</h5>
                <h3>@ViewBag.TodayAppointments</h3>
                <small>@ViewBag.Today</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5>This Month</h5>
                <h3>@ViewBag.MonthAppointments</h3>
                <small>Appointments</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5>Completed</h5>
                <h3>@ViewBag.CompletedAppointments</h3>
                <small>Appointments</small>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5>Total Patients</h5>
                <h3>@ViewBag.TotalPatients</h3>
                <small>Patients</small>
            </div>
        </div>
    </div>
</div>

    <!-- Quick Actions -->
    <div class="row mb-4 mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Calendar", "Appointments")" class="btn btn-primary w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                                <span>View Calendar</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Index", "Appointments")" class="btn btn-success w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-list-alt fa-2x mb-2"></i>
                                <span>My Appointments</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Index", "MedicalRecords")" class="btn btn-info w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-file-medical fa-2x mb-2"></i>
                                <span>Medical Records</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Performance", "Doctors", new { id = Model.doctor_id })" class="btn btn-warning w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-chart-line fa-2x mb-2"></i>
                                <span>Performance</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>