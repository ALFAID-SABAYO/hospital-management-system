@{
    ViewData["Title"] = "Receptionist Dashboard";
    var todayAppointments = ViewBag.TodayAppointmentsList as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var pastAppointments = ViewBag.PastAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var overdueBills = ViewBag.OverdueBills as List<Hospital.Models.Billing> ?? new List<Hospital.Models.Billing>();
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-info text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-1"><i class="fas fa-clipboard-list me-2"></i>Receptionist Dashboard</h3>
                            <p class="card-text mb-0 opacity-75">Appointment & Billing Management</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-info fs-6 px-3 py-2">Reception Desk</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Section -->
    @if (pastAppointments.Any() || overdueBills.Any() || upcomingAppointments.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Alerts & Notifications</h5>
                    </div>
                    <div class="card-body">
                        @if (pastAppointments.Any())
                        {
                            <div class="alert alert-danger mb-3">
                                <strong><i class="fas fa-calendar-times me-2"></i>Past Appointments:</strong>
                                There are <strong>@pastAppointments.Count</strong> appointments in the past that need attention.
                                <a href="@Url.Action("Index", "Appointments")" class="alert-link ms-2">Review Now →</a>
                            </div>
                        }
                        @if (overdueBills.Any())
                        {
                            <div class="alert alert-warning mb-3">
                                <strong><i class="fas fa-file-invoice-dollar me-2"></i>Overdue Bills:</strong>
                                There are <strong>@overdueBills.Count</strong> bills overdue by more than 30 days.
                                <a href="@Url.Action("Index", "Billings")" class="alert-link ms-2">View Bills →</a>
                            </div>
                        }
                        @if (upcomingAppointments.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <strong><i class="fas fa-calendar-check me-2"></i>Upcoming Appointments:</strong>
                                You have <strong>@upcomingAppointments.Count</strong> appointments scheduled in the next 7 days.
                                <a href="@Url.Action("Calendar", "Appointments")" class="alert-link ms-2">View Calendar →</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-calendar-day fa-3x text-primary"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TodayAppointments</h4>
                    <p class="text-muted mb-0">Today's Appointments</p>
                    <small class="text-primary">@ViewBag.MonthAppointments this month</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-check-circle fa-3x text-success"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.CompletedAppointments</h4>
                    <p class="text-muted mb-0">Completed</p>
                    <small class="text-success">@ViewBag.PendingAppointments pending</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-file-invoice-dollar fa-3x text-warning"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.PendingBills</h4>
                    <p class="text-muted mb-0">Pending Bills</p>
                    <small class="text-warning">@ViewBag.PendingRevenue.ToString("C")</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-users fa-3x text-info"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TotalPatients</h4>
                    <p class="text-muted mb-0">Total Patients</p>
                    <a href="@Url.Action("Index", "Patients")" class="btn btn-sm btn-outline-info mt-2">Manage</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Create", "Patients")" class="btn btn-primary w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-user-plus fa-2x mb-2"></i>
                                <span>Register Patient</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Create", "Appointments")" class="btn btn-success w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-plus fa-2x mb-2"></i>
                                <span>Book Appointment</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Calendar", "Appointments")" class="btn btn-info w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                                <span>View Calendar</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Index", "Billings")" class="btn btn-warning w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-file-invoice-dollar fa-2x mb-2"></i>
                                <span>Manage Bills</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content - Today's Appointments -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-calendar-day me-2"></i>Today's Appointments (@DateTime.Today.ToString("MMMM dd, yyyy"))</h5>
                    <a href="@Url.Action("Index", "Appointments")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (todayAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light text-black">
                                    <tr>
                                        <th>Time</th>
                                        <th>Patient</th>
                                        <th>Doctor</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in todayAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@appointment.appointment_date.ToString("hh:mm tt")</strong>
                                            </td>
                                            <td>
                                                @appointment.Patient?.FullName<br>
                                                <small class="text-muted">ID: #@appointment.patient_id</small>
                                            </td>
                                            <td>
                                                Dr. @appointment.Doctor?.FullName<br>
                                                <small class="text-muted">@appointment.Doctor?.specialization</small>
                                            </td>
                                            <td>
                                                @if (appointment.status == "Completed")
                                                {
                                                    <span class="badge bg-success">@appointment.status</span>
                                                }
                                                else if (appointment.status == "Cancelled")
                                                {
                                                    <span class="badge bg-danger">@appointment.status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">@appointment.status</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Appointments", new { id = appointment.appointment_id })" 
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">No appointments scheduled for today</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

