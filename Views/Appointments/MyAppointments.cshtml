@model IEnumerable<Hospital.Models.Appointment>
@using System.Linq

@{
    ViewData["Title"] = "My Appointments";
    var hasAppointments = Model != null && Model.Any();
    var upcomingAppointments = Model?.Where(a => a.appointment_date > DateTime.Now && a.status != "Cancelled" && a.status != "Completed").OrderBy(a => a.appointment_date).ToList() ?? new List<Hospital.Models.Appointment>();
    var pastAppointments = Model?.Where(a => a.appointment_date <= DateTime.Now || a.status == "Completed" || a.status == "Cancelled").OrderByDescending(a => a.appointment_date).ToList() ?? new List<Hospital.Models.Appointment>();
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="fas fa-calendar-check text-primary me-2"></i>My Appointments</h2>
            <p class="text-muted mb-0">View and manage all your appointments</p>
        </div>
        <div>
            <a href="@Url.Action("Create", "Appointments")" class="btn btn-primary btn-lg">
                <i class="fas fa-calendar-plus me-2"></i>Book New Appointment
            </a>
            <a href="@Url.Action("Dashboard", "Patients")" class="btn btn-outline-secondary btn-lg ms-2">
                <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
            </a>
        </div>
    </div>

    @if (!hasAppointments)
    {
        <!-- No Data Message -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                <h3 class="text-muted">No Appointments Found</h3>
                <p class="text-muted mb-4">You don't have any appointments scheduled yet.</p>
                <a href="@Url.Action("Create", "Appointments")" class="btn btn-primary btn-lg">
                    <i class="fas fa-calendar-plus me-2"></i>Book Your First Appointment
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Statistics Cards -->
        <div class="row mb-4">
            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm bg-primary text-white">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-calendar-alt fa-3x mb-3 opacity-75"></i>
                        <h2 class="display-5 fw-bold">@Model.Count()</h2>
                        <p class="mb-0 fs-5">Total Appointments</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm bg-success text-white">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-check-circle fa-3x mb-3 opacity-75"></i>
                        <h2 class="display-5 fw-bold">@Model.Count(a => a.status == "Completed")</h2>
                        <p class="mb-0 fs-5">Completed</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-clock fa-3x mb-3 opacity-75"></i>
                        <h2 class="display-5 fw-bold">@upcomingAppointments.Count</h2>
                        <p class="mb-0 fs-5">Upcoming</p>
                    </div>
                </div>
            </div>

            <div class="col-md-3 mb-3">
                <div class="card border-0 shadow-sm bg-danger text-white">
                    <div class="card-body text-center py-4">
                        <i class="fas fa-times-circle fa-3x mb-3 opacity-75"></i>
                        <h2 class="display-5 fw-bold">@Model.Count(a => a.status == "Cancelled")</h2>
                        <p class="mb-0 fs-5">Cancelled</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Upcoming Appointments -->
        @if (upcomingAppointments.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-calendar-check me-2"></i>Upcoming Appointments</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Appointment ID</th>
                                    <th>Doctor</th>
                                    <th>Date & Time</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in upcomingAppointments)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-primary">APT-@appointment.appointment_id</span>
                                        </td>
                                        <td>
                                            <strong>Dr. @appointment.Doctor?.FullName</strong><br>
                                            <small class="text-muted">@appointment.Doctor?.specialization</small>
                                        </td>
                                        <td>
                                            <strong>@appointment.appointment_date.ToString("MMM dd, yyyy")</strong><br>
                                            <small class="text-muted">@appointment.appointment_date.ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            @if (appointment.status == "Scheduled" || appointment.status == "Confirmed")
                                            {
                                                <span class="badge bg-success">@appointment.status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info">@appointment.status</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="@Url.Action("Details", "Appointments", new { id = appointment.appointment_id })" 
                                               class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Past Appointments -->
        @if (pastAppointments.Any())
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Past Appointments</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light text-black">
                                <tr>
                                    <th class="ps-4">Appointment ID</th>
                                    <th>Doctor</th>
                                    <th>Date & Time</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var appointment in pastAppointments)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <span class="badge bg-secondary">APT-@appointment.appointment_id</span>
                                        </td>
                                        <td>
                                            <strong>Dr. @appointment.Doctor?.FullName</strong><br>
                                            <small class="text-muted">@appointment.Doctor?.specialization</small>
                                        </td>
                                        <td>
                                            <strong>@appointment.appointment_date.ToString("MMM dd, yyyy")</strong><br>
                                            <small class="text-muted">@appointment.appointment_date.ToString("hh:mm tt")</small>
                                        </td>
                                        <td>
                                            @if (appointment.status == "Completed")
                                            {
                                                <span class="badge bg-success">@appointment.status</span>
                                            }
                                            else if (appointment.status == "Cancelled")
                                            {
                                                <span class="badge bg-danger">@appointment.status</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@appointment.status</span>
                                            }
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="@Url.Action("Details", "Appointments", new { id = appointment.appointment_id })" 
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

<style>
    .card {
        transition: transform 0.2s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }
</style>

