@model IEnumerable<Hospital.Models.Appointment>

@{
    ViewData["Title"] = "Appointment Management";
    var hasAppointments = Model != null && Model.Any();
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-calendar-check text-primary"></i> Appointment Management</h2>
        <p class="text-muted">Schedule, track, and manage patient appointments</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-calendar-plus"></i> Book Appointment
    </a>
</div>

@if (!hasAppointments)
{
    <!-- No Data Message -->
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
            <h3 class="text-muted">No Appointments Found</h3>

            @if (User.IsInRole("Patient"))
            {
                <p class="text-muted mb-4">You don't have any appointments scheduled yet.</p>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-calendar-plus me-2"></i>Book Your First Appointment
                </a>
            }
            else
            {
                <p class="text-muted mb-4">There are no appointments in the system yet.</p>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    <i class="fas fa-calendar-plus me-2"></i>Create First Appointment
                </a>
            }

            <div class="mt-4">
                <p class="text-muted small">Or explore other options:</p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="/Doctors" class="btn btn-outline-primary">
                        <i class="fas fa-user-md me-2"></i>View Doctors
                    </a>
                    <a href="/DoctorSchedules" class="btn btn-outline-success">
                        <i class="fas fa-calendar-alt me-2"></i>View Schedules
                    </a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-primary text-white">
                <div class="card-body text-center py-4">
                    <i class="fas fa-calendar-alt fa-3x mb-3 opacity-75"></i>
                    <h2 class="display-5 fw-bold">@Model.Count()</h2>
                    <p class="mb-0 fs-5">Total Appointments</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-success text-white">
                <div class="card-body text-center py-4">
                    <i class="fas fa-check-circle fa-3x mb-3 opacity-75"></i>
                    <h2 class="display-5 fw-bold">@Model.Count(a => a.status == "Completed")</h2>
                    <p class="mb-0 fs-5">Completed</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-warning text-white">
                <div class="card-body text-center py-4">
                    <i class="fas fa-clock fa-3x mb-3 opacity-75"></i>
                    <h2 class="display-5 fw-bold">@Model.Count(a => a.status == "Scheduled" || a.status == "Confirmed")</h2>
                    <p class="mb-0 fs-5">Upcoming</p>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm bg-gradient-danger text-white">
                <div class="card-body text-center py-4">
                    <i class="fas fa-times-circle fa-3x mb-3 opacity-75"></i>
                    <h2 class="display-5 fw-bold">@Model.Count(a => a.status == "Cancelled")</h2>
                    <p class="mb-0 fs-5">Cancelled</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    @* <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Appointments</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-calendar-day text-primary"></i>
                        </span>
                        <input type="date" class="form-control" placeholder="Select Date">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fas fa-user-md text-success"></i>
                        </span>
                        <select class="form-control">
                            <option value="">All Doctors</option>
                            <option value="1">Dr. Smith</option>
                            <option value="2">Dr. Johnson</option>
