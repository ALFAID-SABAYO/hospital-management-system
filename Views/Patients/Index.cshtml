@model IEnumerable<Hospital.Models.Patient>

@{
    ViewData["Title"] = "Patient Management";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-user-injured text-primary"></i> Patient Management</h2>
        <p class="text-muted">Manage patient records and medical information</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-user-plus"></i> Add New Patient
    </a>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-primary text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-users fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Count()</h2>
                <p class="mb-0 fs-5">Total Patients</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-success text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-male fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Count(p => p.gender == "Male")</h2>
                <p class="mb-0 fs-5">Male Patients</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-info text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-female fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Count(p => p.gender == "Female")</h2>
                <p class="mb-0 fs-5">Female Patients</p>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card border-0 shadow-sm bg-gradient-warning text-white">
            <div class="card-body text-center py-4">
                <i class="fas fa-tint fa-3x mb-3 opacity-75"></i>
                <h2 class="display-5 fw-bold">@Model.Select(p => p.blood_group).Distinct().Count()</h2>
                <p class="mb-0 fs-5">Blood Groups</p>
            </div>
        </div>
    </div>
</div>

<!-- Search and Filter Section -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-light">
        <h5 class="mb-0"><i class="fas fa-search me-2"></i>Search & Filter Patients</h5>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-search text-muted"></i>
                    </span>
                    <input type="text" name="searchString" value="@ViewBag.CurrentFilter"
                           class="form-control" placeholder="Search by name, email, or phone...">
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fas fa-tint text-danger"></i>
                    </span>
                    <select name="bloodGroup" class="form-control">
                        <option value="">All Blood Groups</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Patients Table -->
<div class="card border-0 shadow-sm text-dark">
    <div class="card-body p-0 text-dark">
        <div class="table-responsive">
            <table class="table table-hover mb-0 text-dark">
                <thead class="table-light text-dark">
                    <tr>
                        <th class="ps-4">
                            <i class="fas fa-id-card me-2"></i>Patient ID
                        </th>
                        <th>
                            <i class="fas fa-user me-2"></i>Name
                        </th>
                        <th>
                            <i class="fas fa-envelope me-2"></i>Email
                        </th>
                        <th>
                            <i class="fas fa-phone me-2"></i>Phone
                        </th>
                        <th>
                            <i class="fas fa-tint me-2"></i>Blood Group
                        </th>
                        <th>
                            <i class="fas fa-venus-mars me-2"></i>Gender
                        </th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">#@item.patient_id</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3" style="
                                            width: 40px;
                                            height: 40px;
                                            background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);
                                            border-radius: 50%;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            color: white;
                                            font-weight: bold;
                                        ">
                                        @item.first_name?[0]@item.last_name?[0]
                                    </div>
                                    <div>
                                        <strong>@item.first_name @item.last_name</strong>
                                        <div class="small text-muted">ID: @item.patient_id</div>
                                    </div>
                                </div>
                            </td>
                            <td>@item.email</td>
                            <td>@item.contact_number</td>
                            <td>
                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">
                                    <i class="fas fa-tint me-1"></i>@item.blood_group
                                </span>
                            </td>
                            <td>
                                @if (item.gender == "Male")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                        <i class="fas fa-male me-1"></i>@item.gender
                                    </span>
                                }
                                else if (item.gender == "Female")
                                {
                                    <span class="badge bg-pink bg-opacity-10 text-pink border border-pink border-opacity-25" style="color: #e83e8c !important;">
                                        <i class="fas fa-female me-1"></i>@item.gender
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.gender</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@item.patient_id"
                                       class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.patient_id"
                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.patient_id"
                                       class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-light">
        <div class="row align-items-center">
            <div class="col-md-6">
                <span class="text-muted">
                    Showing <strong>@Model.Count()</strong> patients
                </span>
            </div>
            <div class="col-md-6 text-end">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Add New Patient
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Add some custom styles -->
<style>
    .bg-gradient-primary {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%) !important;
    }

    .bg-gradient-success {
        background: linear-gradient(135deg, #198754 0%, #20c997 100%) !important;
    }

    .bg-gradient-info {
        background: linear-gradient(135deg, #0dcaf0 0%, #20c997 100%) !important;
    }

    .bg-gradient-warning {
        background: linear-gradient(135deg, #fd7e14 0%, #ffc107 100%) !important;
    }

    .avatar-circle {
        transition: transform 0.3s ease;
    }

    tr:hover .avatar-circle {
        transform: scale(1.1);
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05) !important;
    }

    .btn-group .btn {
        border-radius: 6px !important;
        margin: 0 2px;
    }
</style>