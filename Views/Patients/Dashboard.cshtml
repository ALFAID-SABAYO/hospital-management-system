@model Hospital.Models.Patient
@{
    ViewData["Title"] = "Patient Dashboard";
    var patientName = ViewBag.PatientName ?? "Patient";
    var appointments = ViewBag.AllAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var pastAppointments = ViewBag.PastAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var bills = ViewBag.Bills as List<Hospital.Models.Billing> ?? new List<Hospital.Models.Billing>();
    var overdueBills = ViewBag.OverdueBills as List<Hospital.Models.Billing> ?? new List<Hospital.Models.Billing>();
    var medicalRecords = ViewBag.RecentRecords as List<Hospital.Models.MedicalRecord> ?? new List<Hospital.Models.MedicalRecord>();
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-1"><i class="fas fa-user-circle me-2"></i>Welcome, @patientName!</h3>
                            <p class="card-text mb-0 opacity-75">Your Personal Health Dashboard</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-primary fs-6 px-3 py-2">Patient ID: @Model.patient_id</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Section -->
    @if (pastAppointments.Any() || overdueBills.Any() || upcomingAppointments.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Alerts & Notifications</h5>
                    </div>
                    <div class="card-body">
                        @if (pastAppointments.Any())
                        {
                            <div class="alert alert-danger mb-3">
                                <strong><i class="fas fa-calendar-times me-2"></i>Past Appointments:</strong>
                                You have <strong>@pastAppointments.Count</strong> appointment(s) in the past that need attention.
                                <a href="@Url.Action("MyAppointments", "Appointments")" class="alert-link ms-2">Review Now →</a>
                            </div>
                        }
                        @if (overdueBills.Any())
                        {
                            <div class="alert alert-warning mb-3">
                                <strong><i class="fas fa-file-invoice-dollar me-2"></i>Overdue Bills:</strong>
                                You have <strong>@overdueBills.Count</strong> bill(s) overdue by more than 30 days.
                                <a href="@Url.Action("MyBills", "Billings")" class="alert-link ms-2">View Bills →</a>
                            </div>
                        }
                        @if (upcomingAppointments.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <strong><i class="fas fa-calendar-check me-2"></i>Upcoming Appointments:</strong>
                                You have <strong>@upcomingAppointments.Count</strong> appointment(s) scheduled soon.
                                <a href="@Url.Action("MyAppointments", "Appointments")" class="alert-link ms-2">View Appointments →</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-calendar-check fa-3x text-primary"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TotalAppointments</h4>
                    <p class="text-muted mb-0">Total Appointments</p>
                    <small class="text-primary">@upcomingAppointments.Count upcoming</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-file-medical fa-3x text-success"></i>
                    </div>
                    <h4 class="mb-1">@medicalRecords.Count</h4>
                    <p class="text-muted mb-0">Medical Records</p>
                    <small class="text-success">Health History</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-file-invoice-dollar fa-3x text-warning"></i>
                    </div>
                    <h4 class="mb-1">@bills.Count</h4>
                    <p class="text-muted mb-0">Total Bills</p>
                    <small class="text-warning">@ViewBag.PendingBills.ToString("C") pending</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-clock fa-3x text-info"></i>
                    </div>
                    @if (upcomingAppointments.Any())
                    {
                        var nextApp = upcomingAppointments.First();
                        <h6 class="mb-1">@nextApp.appointment_date.ToString("MMM dd")</h6>
                        <p class="text-muted mb-0 small">Next Appointment</p>
                        <small class="text-info">Dr. @nextApp.Doctor?.FullName</small>
                    }
                    else
                    {
                        <h6 class="mb-1">None</h6>
                        <p class="text-muted mb-0 small">Next Appointment</p>
                        <small class="text-info">Book an appointment</small>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Action Buttons -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Create", "Appointments")" class="btn btn-primary w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-plus fa-2x mb-2"></i>
                                <span>Book Appointment</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("MyAppointments", "Appointments")" class="btn btn-success w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-list-alt fa-2x mb-2"></i>
                                <span>My Appointments</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("MyRecords", "MedicalRecords")" class="btn btn-info w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-file-medical fa-2x mb-2"></i>
                                <span>Medical Records</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("MyBills", "Billings")" class="btn btn-warning w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-file-invoice-dollar fa-2x mb-2"></i>
                                <span>View Bills</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content - Two Columns -->
    <div class="row">
        <!-- Left Column: My Appointments -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-calendar me-2"></i>My Appointments</h5>
                    <a href="@Url.Action("MyAppointments", "Appointments")" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-eye me-1"></i>View All
                    </a>
                </div>
                <div class="card-body">
                    @if (upcomingAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date & Time</th>
                                        <th>Doctor</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in upcomingAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@appointment.appointment_date.ToString("MMM dd, yyyy")</strong><br>
                                                <small class="text-muted">@appointment.appointment_date.ToString("hh:mm tt")</small>
                                            </td>
                                            <td>
                                                Dr. @appointment.Doctor?.FullName<br>
                                                <small class="text-muted">@appointment.Doctor?.specialization</small>
                                            </td>
                                            <td>
                                                @if (appointment.status == "Scheduled" || appointment.status == "Confirmed")
                                                {
                                                    <span class="badge bg-success">@appointment.status</span>
                                                }
                                                else if (appointment.status == "Cancelled")
                                                {
                                                    <span class="badge bg-danger">@appointment.status</span>
                                                }
                                                else if (appointment.status == "Completed")
                                                {
                                                    <span class="badge bg-secondary">@appointment.status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info">@appointment.status</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Appointments", new { id = appointment.appointment_id })" 
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-3">No upcoming appointments</p>
                            <a href="@Url.Action("Create", "Appointments")" class="btn btn-primary">
                                <i class="fas fa-calendar-plus me-2"></i>Book Your First Appointment
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: My Bills -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-file-invoice-dollar me-2"></i>My Bills</h5>
                    <a href="@Url.Action("MyBills", "Billings")" class="btn btn-sm btn-outline-warning">
                        <i class="fas fa-eye me-1"></i>View All
                    </a>
                </div>
                <div class="card-body">
                    @if (bills.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Bill ID</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var bill in bills.OrderByDescending(b => b.payment_date ?? DateTime.MinValue).Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <strong>#@bill.bill_id</strong>
                                            </td>
                                            <td>
                                                <strong class="text-primary">@bill.total_amount.ToString("C")</strong>
                                            </td>
                                            <td>
                                                @if (bill.payment_status == "Paid")
                                                {
                                                    <span class="badge bg-success">@bill.payment_status</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">@bill.payment_status</span>
                                                }
                                            </td>
                                            <td>
                                                @if (bill.payment_date.HasValue)
                                                {
                                                    @bill.payment_date.Value.ToString("MMM dd, yyyy")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Pending</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "Billings", new { id = bill.bill_id })" 
                                                   class="btn btn-sm btn-outline-info" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0"><strong>No record found</strong></p>
                            <p class="text-muted small mt-2">You don't have any bills yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Medical Records Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-file-medical me-2"></i>Recent Medical Records</h5>
                    <a href="@Url.Action("MyRecords", "MedicalRecords")" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-eye me-1"></i>View All
                    </a>
                </div>
                <div class="card-body">
                    @if (medicalRecords.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Visit Date</th>
                                        <th>Diagnosis</th>
                                        <th>Doctor</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var record in medicalRecords)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@record.visit_date.ToString("MMM dd, yyyy")</strong>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(record.diagnosis) && record.diagnosis.Length > 50)
                                                {
                                                    @record.diagnosis.Substring(0, 50)
                                                    <text>...</text>
                                                }
                                                else
                                                {
                                                    @(record.diagnosis ?? "N/A")
                                                }
                                            </td>
                                            <td>
                                                @if (record.Appointment?.Doctor != null)
                                                {
                                                    <span>Dr. @record.Appointment.Doctor.FullName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Details", "MedicalRecords", new { id = record.record_id })" 
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-file-medical fa-3x text-muted mb-3"></i>
                            <p class="text-muted mb-0">No medical records yet</p>
                            <p class="text-muted small mt-2">Your medical records will appear here after appointments.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Patient Information Card -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>My Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Patient ID:</strong><br>
                            <span class="text-primary fs-5">@Model.patient_id</span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Name:</strong><br>
                            <span class="fs-5">@Model.first_name @Model.last_name</span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Email:</strong><br>
                            <span>@Model.email</span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Phone:</strong><br>
                            <span>@Model.contact_number</span>
                        </div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Gender:</strong><br>
                            <span>@Model.gender</span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Date of Birth:</strong><br>
                            <span>@Model.date_of_birth.ToString("MMMM dd, yyyy")</span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Blood Group:</strong><br>
                            <span>@(string.IsNullOrEmpty(Model.blood_group) ? "Not specified" : Model.blood_group)</span>
                        </div>
                        <div class="col-md-3 mb-3">
                            <strong class="text-muted">Address:</strong><br>
                            <span>@(string.IsNullOrEmpty(Model.address) ? "Not specified" : Model.address)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        transition: transform 0.2s ease-in-out;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
    
    .btn {
        transition: all 0.3s ease;
    }
    
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.15);
    }
    
    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }
</style>
