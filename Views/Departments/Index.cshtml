@model IEnumerable<Hospital.Models.DepartmentWithDoctorCountVM>

@{
    ViewData["Title"] = "Hospital Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0 text-dark">
            <i class="fas fa-building text-primary"></i> Hospital Departments
        </h2>
        <p class="text-muted mb-0">Manage medical departments and specialties</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle me-2"></i> Add New Department
    </a>
</div>

<!-- ================= TOGGLE BUTTONS ================= -->
<div class="mb-4">
    <div class="btn-group" role="group">
        <button id="gridBtn" class="btn btn-outline-primary active">
            <i class="fas fa-th-large me-1"></i> Grid
        </button>
        <button id="listBtn" class="btn btn-outline-primary">
            <i class="fas fa-list me-1"></i> List
        </button>
    </div>
</div>

<!-- ================= GRID VIEW ================= -->
<div id="gridView" class="row mb-4">
    @foreach (var dept in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">

                    <div class="mb-3"
                         style="width:80px;height:80px;margin:auto;
                                border-radius:50%;background:#0d6efd;
                                display:flex;align-items:center;
                                justify-content:center;color:white;
                                font-size:2rem;">
                        <i class="fas fa-building"></i>
                    </div>

                    <h5 class="fw-bold">@dept.Name</h5>
                    <p class="text-muted">@dept.Location</p>

                    <span class="badge bg-info bg-opacity-10 text-dark mb-3">
                        <i class="fas fa-user-md me-1"></i>
                        @dept.DoctorCount Doctors
                    </span>

                    <div class="mt-3">
                        <a asp-action="Details" asp-route-id="@dept.DepartmentId"
                           class="btn btn-sm btn-outline-info me-1">View</a>

                        <a asp-action="Edit" asp-route-id="@dept.DepartmentId"
                           class="btn btn-sm btn-outline-warning me-1">Edit</a>

                        <a asp-action="Delete" asp-route-id="@dept.DepartmentId"
                           class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ================= LIST VIEW ================= -->
<div id="listView" class="card border-0 shadow-sm" style="display:none;">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Location</th>
                    <th>Doctors</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td>@dept.DepartmentId</td>
                        <td>@dept.Name</td>
                        <td>@dept.Location</td>
                        <td>@dept.DoctorCount</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@dept.DepartmentId"
                               class="btn btn-sm btn-outline-info me-1">View</a>

                            <a asp-action="Edit" asp-route-id="@dept.DepartmentId"
                               class="btn btn-sm btn-outline-warning me-1">Edit</a>

                            <a asp-action="Delete" asp-route-id="@dept.DepartmentId"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const gridBtn = document.getElementById("gridBtn");
        const listBtn = document.getElementById("listBtn");
        const gridView = document.getElementById("gridView");
        const listView = document.getElementById("listView");

        gridBtn.onclick = () => {
            gridView.style.display = "flex";
            listView.style.display = "none";
            gridBtn.classList.add("active");
            listBtn.classList.remove("active");
        };

        listBtn.onclick = () => {
            gridView.style.display = "none";
            listView.style.display = "block";
            listBtn.classList.add("active");
            gridBtn.classList.remove("active");
        };
    </script>
}
