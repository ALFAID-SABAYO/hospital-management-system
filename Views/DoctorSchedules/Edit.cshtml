@model Hospital.Models.DoctorSchedule

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>DoctorSchedule</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="schedule_id" />
            <div class="form-group">
                <label asp-for="doctor_id" class="control-label"></label>
                <select asp-for="doctor_id" class="form-control" asp-items="ViewBag.doctor_id"></select>
                <span asp-validation-for="doctor_id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="available_date" class="control-label"></label>
                <input asp-for="available_date" class="form-control" />
                <span asp-validation-for="available_date" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="start_time" class="control-label"></label>
                <input asp-for="start_time" class="form-control" />
                <span asp-validation-for="start_time" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="end_time" class="control-label"></label>
                <input asp-for="end_time" class="form-control" />
                <span asp-validation-for="end_time" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
