@{
    ViewData["Title"] = "Admin Dashboard";
    var recentAppointments = ViewBag.RecentAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var upcomingAppointments = ViewBag.UpcomingAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var pastAppointments = ViewBag.PastAppointments as List<Hospital.Models.Appointment> ?? new List<Hospital.Models.Appointment>();
    var overdueBills = ViewBag.OverdueBillsList as List<Hospital.Models.Billing> ?? new List<Hospital.Models.Billing>();
}

<div class="container-fluid py-4">
    <!-- Welcome Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body py-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-1"><i class="fas fa-user-shield me-2"></i>Admin Dashboard</h3>
                            <p class="card-text mb-0 opacity-75">Hospital Management System Overview</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-danger fs-6 px-3 py-2">System Administrator</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Section -->
    @if (pastAppointments.Any() || overdueBills.Any() || upcomingAppointments.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-warning text-dark">
                        <h5 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Alerts & Notifications</h5>
                    </div>
                    <div class="card-body">
                        @if (pastAppointments.Any())
                        {
                            <div class="alert alert-danger mb-3">
                                <strong><i class="fas fa-calendar-times me-2"></i>Past Appointments:</strong>
                                There are <strong>@pastAppointments.Count</strong> appointments in the past that are still marked as Scheduled/Confirmed.
                                <a href="@Url.Action("Index", "Appointments")" class="alert-link ms-2">Review Now →</a>
                            </div>
                        }
                        @if (overdueBills.Any())
                        {
                            <div class="alert alert-warning mb-3">
                                <strong><i class="fas fa-file-invoice-dollar me-2"></i>Overdue Bills:</strong>
                                There are <strong>@overdueBills.Count</strong> bills overdue by more than 30 days.
                                <a href="@Url.Action("Index", "Billings")" class="alert-link ms-2">View Bills →</a>
                            </div>
                        }
                        @if (upcomingAppointments.Any())
                        {
                            <div class="alert alert-info mb-0">
                                <strong><i class="fas fa-calendar-check me-2"></i>Upcoming Appointments:</strong>
                                You have <strong>@upcomingAppointments.Count</strong> appointments scheduled in the next 7 days.
                                <a href="@Url.Action("Calendar", "Appointments")" class="alert-link ms-2">View Calendar →</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Quick Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-users fa-3x text-primary"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TotalPatients</h4>
                    <p class="text-muted mb-0">Total Patients</p>
                    <a href="@Url.Action("Index", "Patients")" class="btn btn-sm btn-outline-primary mt-2">Manage</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-user-md fa-3x text-success"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TotalDoctors</h4>
                    <p class="text-muted mb-0">Total Doctors</p>
                    <a href="@Url.Action("Index", "Doctors")" class="btn btn-sm btn-outline-success mt-2">Manage</a>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-calendar-check fa-3x text-info"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TodayAppointments</h4>
                    <p class="text-muted mb-0">Today's Appointments</p>
                    <small class="text-info">@ViewBag.MonthAppointments this month</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="mb-3">
                        <i class="fas fa-dollar-sign fa-3x text-warning"></i>
                    </div>
                    <h4 class="mb-1">@ViewBag.TotalRevenue.ToString("C")</h4>
                    <p class="text-muted mb-0">Total Revenue</p>
                    <small class="text-warning">@ViewBag.PendingRevenue.ToString("C") pending</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-bolt me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Create", "Patients")" class="btn btn-primary w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-user-plus fa-2x mb-2"></i>
                                <span>Register Patient</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Create", "Appointments")" class="btn btn-success w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-plus fa-2x mb-2"></i>
                                <span>Book Appointment</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("Calendar", "Appointments")" class="btn btn-info w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-calendar-alt fa-2x mb-2"></i>
                                <span>View Calendar</span>
                            </a>
                        </div>
                        <div class="col-md-3 col-sm-6">
                            <a href="@Url.Action("DailyAppointments", "Reports")" class="btn btn-warning w-100 py-3 d-flex flex-column align-items-center">
                                <i class="fas fa-file-alt fa-2x mb-2"></i>
                                <span>View Reports</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content - Two Columns -->
    <div class="row">
        <!-- Left Column: Today's Appointments -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-calendar-day me-2"></i>Today's Appointments</h5>
                    <a href="@Url.Action("DailyAppointments", "Reports")" class="btn btn-sm btn-outline-primary">View Report</a>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        <strong>Total:</strong> @ViewBag.TodayAppointments | 
                        <strong>Completed:</strong> @ViewBag.CompletedAppointments | 
                        <strong>Pending:</strong> @ViewBag.PendingAppointments
                    </p>
                    <a href="@Url.Action("Index", "Appointments")" class="btn btn-sm btn-outline-secondary mb-3">View All Appointments</a>
                </div>
            </div>
        </div>

        <!-- Right Column: System Statistics -->
        <div class="col-lg-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>System Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <strong class="text-primary">@ViewBag.TotalAppointments</strong>
                                <p class="mb-0 text-muted small">Total Appointments</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <strong class="text-success">@ViewBag.CompletedAppointments</strong>
                                <p class="mb-0 text-muted small">Completed</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <strong class="text-warning">@ViewBag.TotalBills</strong>
                                <p class="mb-0 text-muted small">Total Bills</p>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 bg-light rounded">
                                <strong class="text-danger">@ViewBag.OverdueBills</strong>
                                <p class="mb-0 text-muted small">Overdue Bills</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

